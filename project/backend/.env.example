# =============================================================================
# Configuração do Sistema - Gerenciamento de Atendimento (Abastecimento de Água)
# Copie este arquivo para ".env" e ajuste os valores para o seu ambiente.
# =============================================================================

# --- Servidor ---
# HOST: interface de escuta (0.0.0.0 = todas as interfaces locais; localhost para testes locais)
HOST=0.0.0.0
PORT=3000
NODE_ENV=development

# --- Banco de dados (MariaDB) ---
# Configure para apontar para a máquina servidor em rede local
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=aguafila_db
DB_CONNECTION_LIMIT=10

# --- CORS ---
# Origens permitidas (separadas por vírgula).
# Use "*" para liberar tudo em rede local fechada.
# Exemplos: "http://192.168.1.100:3000", "http://192.168.1.0/24", "*"
CORS_ORIGIN=*

# --- Impressão (PrinterService) ---
# Driver ativo: "console" (padrão/desenvolvimento), "escpos", "usb", "serial", "rede"
PRINTER_DRIVER=console
PRINTER_PORT=tcp://localhost:9100

# --- Áudio (AudioService) ---
# Modo: "tts" (Web Speech API no cliente do painel) ou "arquivo" (áudios pré-gravados)
AUDIO_MODE=tts
AUDIO_VOLUME=100

# --- Regras de negócio ---
TOTAL_ESTEIRAS=2
REINICIO_DIARIO=true

# --- Logs ---
LOG_LEVEL=info
